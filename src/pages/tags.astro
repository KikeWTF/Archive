---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagCloud } from '../lib/references';
---

<BaseLayout
  title="Tags — Kike's Archive"
  description="Tag list of Kike Fontán's archive. Click a tag to filter the references."
>
  <header class="page-hero">
    <h1 class="page-hero__title">Tags</h1>
    <p class="page-hero__subtitle">
      Browse the archive by topic. Click a tag to filter the references.
    </p>
  </header>

  <section class="section section--tags">
    <ul class="tag-list">
      {
        tagCloud.map(({ tag, count }) => (
          <li class="tag-list__item">
            <a
              class="tag-list__link"
              href={`/archive/?tag=${encodeURIComponent(tag)}`}
            >
              <span class="tag-list__name">{tag}</span>
              <span class="tag-list__count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
